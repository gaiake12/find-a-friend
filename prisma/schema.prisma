generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pet {
  id     String @id @default(uuid())
  search String
  race   String
  color  String
  orgId  String @map("org_id")
  org    org    @relation(fields: [orgId], references: [id])

  @@map("pet")
}

model org {
  id           String  @id @default(uuid())
  name         String
  passwordHash String  @map("password_hash")
  description  String?
  city         String
  phone        String
  Pet          Pet[]

  @@map("org")
}
