// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String @id @default(uuid())
  name          String
  email         String
  phone         String
  password_hash String

  @@map("user")
}

model Pet {
  id    String @id @default(uuid())
  race  String
  color String
  ORGId String @map("ORG_id")
  ORG   ORG    @relation(fields: [ORGId], references: [id])

  @@map("pet")
}

model ORG {
  id          String @id @default(uuid())
  name        String
  description String
  city        String
  phone       String
  Pet         Pet[]

  @@map("ORG")
}
